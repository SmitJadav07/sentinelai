# ==============================================
# TESTING CONFIGURATION - Minimal API Usage
# ==============================================

# Use mock council results instead of calling Gemini API (saves credits!)
TEST_MODE=true

# Disable the automatic background loop (saves tons of credits!)
LOOP_ENABLED=false

# If you enable LOOP_ENABLED, how often to run (in seconds)
LOOP_INTERVAL=300

# ==============================================
# Production API Keys (only if not in TEST_MODE)
# ==============================================
GROQ_API_KEY=your_groq_api_key_here
HEDERA_ACCOUNT_ID=0.0.9224996
HEDERA_PRIVATE_KEY=your_hedera_private_key_here
CIRCLE_API_KEY=your_circle_api_key_here

# ==============================================
# Testing Tips:
# - TEST_MODE=true: Mock council results (no API calls)
# - LOOP_ENABLED=false: No automatic generation (manual only)
# - For manual testing: POST /attack to trigger one event
# - View results: GET /events
# ==============================================